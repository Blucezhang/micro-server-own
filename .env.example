# Copy this file to .env and replace every change-me value before starting Compose.
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_PASSWORD=change-me-mysql
NEO4J_PASSWORD=change-me-neo4j
EUREKA_USER=own
EUREKA_PASSWORD=change-me-eureka
# JWT is enabled at the gateway by default. Replace this demo secret before any shared deployment.
JWT_ENABLED=true
JWT_ISSUER=micro-server-own
JWT_SECRET=change-me-jwt-signing-key-at-least-32-bytes
JWT_PREVIOUS_SECRET=
JWT_EXPIRATION_SECONDS=7200
JWT_REFRESH_EXPIRATION_SECONDS=1209600
JWT_REFRESH_SESSION_CLEANUP_DELAY_MS=3600000
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15
LOGIN_ATTEMPT_RETENTION_DAYS=90
LOGIN_ATTEMPT_CLEANUP_DELAY_MS=86400000
# Set true only when a trusted reverse proxy overwrites forwarded-client headers before the gateway.
GATEWAY_RATELIMIT_BEHIND_PROXY=false
# Internal endpoints require this independent shared secret; use 32+ random bytes.
INTERNAL_SERVICE_TOKEN=
INTERNAL_SERVICE_PREVIOUS_TOKEN=
REVIEW_PROHIBITED_TERMS=
# Optional order-event Webhook. Both values are required to enable delivery; use a random 32+ byte secret.
ORDER_OUTBOX_WEBHOOK_URL=
ORDER_OUTBOX_WEBHOOK_SECRET=
# Demo-only payment and settlement configuration. Replace all values with managed secrets before production.
PAYMENT_CHANNEL=MOCK_WECHAT
PAYMENT_MOCK_CALLBACK_TOKEN=change-me-payment-callback-token-32-bytes
WECHAT_APP_ID=demo-wechat-app-id
WECHAT_MERCHANT_ID=demo-wechat-merchant-id
WECHAT_API_V3_KEY=demo-only-replace-before-production
ALIPAY_APP_ID=demo-alipay-app-id
ALIPAY_GATEWAY=https://openapi-sandbox.dl.alipaydev.com/gateway.do
SETTLEMENT_MERCHANT_RATE=0.80
SETTLEMENT_PLATFORM_RATE=0.20
SETTLEMENT_CYCLE_DAYS=7
SETTLEMENT_WITHDRAWAL_MINIMUM=100.00
