      "description": "基础变体的视觉摘录；hover 的 90% 主色透明度来自源码，不代表 Ant 按钮。",
      "html": "<button type=\"button\" class=\"ds-button-primary\">保存设置</button>",
      "css": ".ds-button-primary{font-family:var(--font-family,-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,'Helvetica Neue',Arial,'Noto Sans',sans-serif);display:inline-flex;align-items:center;justify-content:center;white-space:nowrap;border-radius:calc(var(--radius,0.5rem) - 2px);font-size:0.875rem;font-weight:500;line-height:1.25rem;height:2.25rem;padding:0.5rem 1rem;transition:color 150ms,background-color 150ms;cursor:pointer;background:hsl(var(--primary, 212 100% 45%));color:hsl(var(--primary-foreground, 0 0% 98%));border:0;}.ds-button-primary:hover{background:hsl(var(--primary,212 100% 45%) / 90%);}.ds-button-primary:focus-visible{outline:1px solid hsl(var(--foreground, 210 6% 21%));outline-offset:2px;}.ds-button-primary:disabled{opacity:0.5;cursor:not-allowed;pointer-events:none;}"
    },
    {
      "name": "Vben 描边按钮",
      "kind": "button",
      "refersTo": "button-outline",
