      "css": ".ds-nav{font-family:var(--font-family,-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,'Helvetica Neue',Arial,'Noto Sans',sans-serif);background:hsl(var(--menu,0 0% 100%));padding:0.25rem 0;}.ds-nav-item{display:flex;align-items:center;min-height:38px;margin:0 8px 2px;padding:0 12px;border-radius:8px;color:hsl(var(--foreground, 210 6% 21%));font-size:var(--menu-font-size,0.875rem);text-decoration:none;transition:background 150ms ease,color 150ms ease;}.ds-nav-item:hover{background:hsl(var(--accent, 240 5% 96%));}.ds-nav-item[aria-current=page]{background:hsl(var(--primary,212 100% 45%) / 15%);color:hsl(var(--primary, 212 100% 45%));}.ds-nav-item:focus-visible{outline:1px solid hsl(var(--primary, 212 100% 45%));outline-offset:2px;}:host-context(.dark) .ds-nav-item[aria-current=page]{background:hsl(var(--accent, 240 5% 96%));color:hsl(var(--accent-foreground,0 0% 98%));}"
    },
    {
      "name": "Vben 分段标签页",
      "kind": "nav",
      "refersTo": "tabs",
      "description": "TabsList/TabsTrigger 的状态示意；原组件负责键盘与选中行为，此处不复制其运行时。",
      "html": "<div class=\"ds-tabs\" role=\"group\" aria-label=\"标签页外观示意\"><button class=\"ds-tab\" type=\"button\" aria-pressed=\"true\">流量趋势</button><button class=\"ds-tab\" type=\"button\" aria-pressed=\"false\">月访问量</button></div>",
      "css": ".ds-tabs{font-family:var(--font-family,-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,'Helvetica Neue',Arial,'Noto Sans',sans-serif);display:inline-flex;height:2.25rem;box-sizing:border-box;align-items:center;justify-content:center;border-radius:calc(var(--radius,0.5rem) - 2px);background:hsl(var(--muted, 240 4.8% 95.9%));color:hsl(var(--muted-foreground, 240 3.8% 46.1%));padding:0.25rem;}.ds-tab{font-family:var(--font-family,-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,'Helvetica Neue',Arial,'Noto Sans',sans-serif);display:inline-flex;align-items:center;justify-content:center;height:calc(100% - 1px);border:1px solid transparent;border-radius:calc(var(--radius,0.5rem) - 2px);padding:0.25rem 0.5rem;background:transparent;color:hsl(var(--foreground, 210 6% 21%));font-size:0.875rem;font-weight:500;white-space:nowrap;}.ds-tab[aria-pressed=true]{background:hsl(var(--background, 0 0% 100%));box-shadow:0 1px 3px 0 rgb(0 0 0 / 0.1), 0 1px 2px -1px rgb(0 0 0 / 0.1);}.ds-tab:focus-visible{outline:1px solid hsl(var(--foreground, 210 6% 21%));outline-offset:2px;}.ds-tab:disabled{opacity:0.5;pointer-events:none;}:host-context(.dark) .ds-tab{color:hsl(var(--muted-foreground, 240 3.8% 46.1%));}:host-context(.dark) .ds-tab[aria-pressed=true]{color:hsl(var(--foreground, 210 6% 21%));border-color:hsl(var(--input,0 0% 100% / 10%));background:color-mix(in oklab,hsl(var(--input,0 0% 100% / 10%)) 30%,transparent);}"
    },
