      "html": "<input class=\"ds-input\" type=\"text\" aria-label=\"示例名称\" placeholder=\"请输入名称\" />",
      "css": ".ds-input{font-family:var(--font-family,-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,'Helvetica Neue',Arial,'Noto Sans',sans-serif);display:flex;box-sizing:border-box;width:100%;height:2.5rem;border:1px solid hsl(var(--input,240deg 5.88% 90%));border-radius:calc(var(--radius,0.5rem) - 2px);background:hsl(var(--background, 0 0% 100%));color:hsl(var(--foreground, 210 6% 21%));padding:0.5rem 0.75rem;font-size:0.875rem;line-height:1.25rem;}.ds-input::placeholder{color:hsl(var(--muted-foreground,240 3.8% 46.1%) / 50%);}.ds-input:focus-visible{outline:none;box-shadow:inset 0 0 0 1px hsl(var(--primary, 212 100% 45%));}.ds-input:disabled{opacity:0.5;cursor:not-allowed;}"
