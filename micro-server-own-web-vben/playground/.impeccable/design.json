      "html": "<button type=\"button\" class=\"ds-button-ghost\">查看更多</button>",
      "css": ".ds-button-ghost{font-family:var(--font-family,-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,'Helvetica Neue',Arial,'Noto Sans',sans-serif);display:inline-flex;align-items:center;justify-content:center;white-space:nowrap;border-radius:calc(var(--radius,0.5rem) - 2px);font-size:0.875rem;font-weight:500;line-height:1.25rem;height:2.25rem;padding:0.5rem 1rem;transition:color 150ms,background-color 150ms;cursor:pointer;background:transparent;border:0;color:hsl(var(--foreground, 210 6% 21%));}.ds-button-ghost:hover{background:hsl(var(--accent, 240 5% 96%));color:hsl(var(--accent-foreground,240 6% 10%));}.ds-button-ghost:focus-visible{outline:1px solid hsl(var(--foreground, 210 6% 21%));outline-offset:2px;}.ds-button-ghost:disabled{opacity:0.5;cursor:not-allowed;pointer-events:none;}"
