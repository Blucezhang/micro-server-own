      "html": "<button type=\"button\" class=\"ds-button-outline\">取消</button>",
      "css": ".ds-button-outline{font-family:var(--font-family,-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,'Helvetica Neue',Arial,'Noto Sans',sans-serif);display:inline-flex;align-items:center;justify-content:center;white-space:nowrap;border-radius:calc(var(--radius,0.5rem) - 2px);font-size:0.875rem;font-weight:500;line-height:1.25rem;height:2.25rem;padding:0.5rem 1rem;transition:color 150ms,background-color 150ms;cursor:pointer;background:hsl(var(--background, 0 0% 100%));color:hsl(var(--foreground, 210 6% 21%));border:1px solid hsl(var(--input,240deg 5.88% 90%));box-shadow:0 1px 3px 0 rgb(0 0 0 / 0.1), 0 1px 2px -1px rgb(0 0 0 / 0.1);}.ds-button-outline:hover{background:hsl(var(--accent, 240 5% 96%));color:hsl(var(--accent-foreground,240 6% 10%));}.ds-button-outline:focus-visible{outline:1px solid hsl(var(--foreground, 210 6% 21%));outline-offset:2px;}.ds-button-outline:disabled{opacity:0.5;cursor:not-allowed;pointer-events:none;}"
    },
